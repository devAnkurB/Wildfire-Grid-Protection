{
  "claim_scope": "Results represent expected-loss-ranked risk prioritization under public-data assumptions and literature-derived intervention effect sizes. Dollar figures are modeled estimates, not causal predictions of actual savings. Uncertainty bounds reflect sampling variability in the cluster-level EAL distribution.",
  "methodology": {
    "risk_decomposition": "ExpectedLoss(s,t)=P_ignition(s,t)*E(Loss|ignition,s,t)",
    "policy_sequence": [
      "Apply fast-trip baseline to all HFTD clusters",
      "Compute residual EAL after fast-trip",
      "Escalate to covered conductor for high residual EAL",
      "Reserve undergrounding for extreme residual EAL + high structure density",
      "Use vegetation management in vegetated-fuel moderate residual EAL clusters"
    ],
    "severity_model": {
      "type": "empirical_frap_lookup",
      "description": "Static cluster-level lookup from FRAP (1992-2024) stratified by HFTD tier and LANDFIRE fuel category.",
      "large_fire_threshold_ac": 10.0,
      "combination": "E(area|ign,s)=P_large(s)*E_area_large(s)+(1-P_large(s))*E_area_small(s)",
      "stratification": [
        "hftd_tier",
        "fuel_category"
      ],
      "min_events_per_stratum": 30,
      "backfill_order": [
        "hftd_tier",
        "statewide"
      ],
      "frap_filters": {
        "year_min": 1992,
        "year_max": 2024,
        "min_acres": 10.0,
